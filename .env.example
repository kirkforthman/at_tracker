# Copy to .env (gitignored) and fill in. Every service reads its config from here.

# OpenSky API client (https://opensky-network.org > Account > API client).
# Leave empty to run anonymously (400 credits/day; too few for 90 s polling).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Chat model: any OpenAI-compatible endpoint. Default is the llama.cpp container.
LLM_BASE_URL=http://localhost:8081/v1
LLM_MODEL=gpt-oss-20b

# Databases (used from P1 / P5)
POSTGRES_USER=at_tracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=at_tracker
NEO4J_AUTH=neo4j/change-me-please
